{
  "framework": null,
  "outputDirectory": ".",
  "buildCommand": "cd docs-site && npm install && npm run build && rm -rf node_modules && cd .. && rm -rf node_modules",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://unpkg.com https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/simulate",
      "destination": "/api/index"
    },
    {
      "source": "/equity-analysis",
      "destination": "/api/index"
    },
    {
      "source": "/sensitivity",
      "destination": "/api/index"
    },
    {
      "source": "/what-if",
      "destination": "/api/index"
    },
    {
      "source": "/rank-stability",
      "destination": "/api/index"
    },
    {
      "source": "/multi-listing",
      "destination": "/api/index"
    },
    {
      "source": "/score",
      "destination": "/api/index"
    },
    {
      "source": "/score/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/centers",
      "destination": "/api/index"
    },
    {
      "source": "/centers/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/trends/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/spatial-layers",
      "destination": "/api/index"
    },
    {
      "source": "/interpolated-value",
      "destination": "/api/index"
    },
    {
      "source": "/interpolated-profile",
      "destination": "/api/index"
    },
    {
      "source": "/allocation-circles",
      "destination": "/api/index"
    },
    {
      "source": "/distance-score",
      "destination": "/api/index"
    },
    {
      "source": "/spatial-grid",
      "destination": "/api/index"
    },
    {
      "source": "/location-delta",
      "destination": "/api/index"
    },
    {
      "source": "/policy-scenarios",
      "destination": "/api/index"
    },
    {
      "source": "/policy-scenarios/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/policy-scenario",
      "destination": "/api/index"
    },
    {
      "source": "/travel-subsidy-analysis",
      "destination": "/api/index"
    },
    {
      "source": "/validation/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/tier",
      "destination": "/api/index"
    },
    {
      "source": "/bias-audit",
      "destination": "/api/index"
    },
    {
      "source": "/weight-range",
      "destination": "/api/index"
    }
  ],
  "installCommand": "echo 'skip root npm install (dev-only deps; #343)'"
}
